#!/bin/sh

# Check the destination ref, including explicit refspecs and deletions.
while read -r local_ref local_oid remote_ref remote_oid; do
    if [ "$remote_ref" = "refs/heads/main" ]; then
        echo "Push to main is blocked. Use GDAI-Some-Feature-Title-Zhulynskyi-Danylo and open a PR; the owner merges it." >&2
        exit 1
    fi
done

exit 0
